<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Barra superior azul marino, acentos amarillos y botones redondeados -->
    <style name="Tema.Celulares" parent="Theme.MaterialComponents.Light.DarkActionBar">
        <item name="colorPrimary">@color/azul</item>
        <item name="colorPrimaryVariant">@color/azul</item>
        <item name="colorOnPrimary">@color/blanco</item>
        <item name="colorSecondary">@color/amarillo</item>
        <item name="colorOnSecondary">@color/azul</item>
        <item name="colorAccent">@color/azul</item>
        <item name="android:statusBarColor">@color/azul</item>
        <item name="android:windowBackground">@color/fondo</item>
        <item name="android:textColorPrimary">@color/texto</item>
        <item name="materialButtonStyle">@style/Boton</item>
        <item name="textInputStyle">@style/Campo</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement" tools:targetApi="35" xmlns:tools="http://schemas.android.com/tools">true</item>
    </style>

    <style name="Boton" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/amarillo</item>
        <item name="android:textColor">@color/azul</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">15sp</item>
        <item name="cornerRadius">24dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="Boton.Secundario" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textColor">@color/azul</item>
        <item name="strokeColor">@color/azul</item>
        <item name="strokeWidth">2dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">24dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="Boton.Peligro" parent="Boton.Secundario">
        <item name="android:textColor">@color/error</item>
        <item name="strokeColor">@color/error</item>
    </style>

    <style name="Campo" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/azul</item>
        <item name="hintTextColor">@color/azul</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
    </style>

    <style name="Titulo">
        <item name="android:textColor">@color/azul</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Subtitulo">
        <item name="android:textColor">@color/texto_suave</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="Tarjeta" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">14dp</item>
        <item name="cardElevation">2dp</item>
        <item name="cardBackgroundColor">@color/blanco</item>
        <item name="contentPadding">16dp</item>
    </style>
</resources>
