<?xml version="1.0" encoding="utf-8"?>
<!-- Portada: imagen de la agencia y accesos a las funciones de la comercializadora -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="3dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="260dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Atención al cliente en una agencia bancaria"
                    android:scaleType="centerCrop"
                    android:src="@drawable/portada" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:background="@drawable/degradado_portada"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingTop="40dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Comercializadora de Celulares"
                        android:textColor="@color/blanco"
                        android:textSize="21sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Efectivo con 42 % de descuento o crédito directo BanQuito"
                        android:textColor="@color/amarillo"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            style="@style/Subtitulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="8dp"
            android:text="¿Qué deseas hacer?" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCatalogo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:text="Catálogo de celulares" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFacturar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:text="Facturar venta" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFacturas"
            style="@style/Boton.Secundario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:text="Consultar factura" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAmortizacion"
            style="@style/Boton.Secundario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tabla de amortización" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:text="ESPE · Arquitectura de Software · NRC 36883 · Grupo 08"
            android:textColor="@color/texto_suave"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
