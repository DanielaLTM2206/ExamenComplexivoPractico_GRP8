<?xml version="1.0" encoding="utf-8"?>
<!-- Cambiar servidor: IP de la PC donde corre Payara, con prueba de conexión antes de guardar -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <com.google.android.material.card.MaterialCardView
                style="@style/Tarjeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Titulo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Dirección del servidor"
                        android:textSize="17sp" />

                    <TextView
                        style="@style/Subtitulo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:lineSpacingExtra="2dp"
                        android:text="Escriba la IP de la PC donde corre Payara. El celular y la PC deben estar en la misma red Wi-Fi; la IP aparece al ejecutar PREPARAR_SERVIDOR_SOAP_8080.bat." />

                    <TextView
                        android:id="@+id/txtUrlActual"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@color/azul_claro"
                        android:padding="10dp"
                        android:textColor="@color/azul"
                        android:textSize="13sp" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/campoServidor"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:hint="IP o dirección del servidor"
                        app:helperText="Ejemplo: 192.168.1.25 (se completa con :8080 y la ruta del servicio)"
                        app:helperTextEnabled="true">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/txtServidor"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:digits="0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ.:/-_?"
                            android:imeOptions="actionDone"
                            android:inputType="textUri"
                            android:maxLength="200" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:id="@+id/txtResultado"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:lineSpacingExtra="2dp"
                        android:padding="10dp"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:visibility="gone" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnProbar"
                        style="@style/Boton.Secundario"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Probar conexión" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnGuardar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Guardar" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRestablecer"
                        style="@style/Boton.Peligro"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Restablecer" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>

    <include layout="@layout/cargando" />
</FrameLayout>
